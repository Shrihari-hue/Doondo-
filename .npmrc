# Doondo workspace pnpm config.
#
# node-linker=hoisted — use a flat node_modules layout (like npm/yarn) instead
# of pnpm's default symlinked layout. Required for Expo + React Native + Metro
# bundler, which doesn't traverse pnpm's symlinks reliably and can't find
# transitive deps like expo-modules-core and @babel/runtime/helpers.
#
# This is the canonical fix recommended by Expo for monorepos.
node-linker=hoisted

# Some Expo and RN packages expect to live at the top level of node_modules.
# Without these patterns, Metro can fail to resolve them inside pnpm's strict
# isolation.
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=@react-native*
public-hoist-pattern[]=react-native*
public-hoist-pattern[]=@babel/runtime*

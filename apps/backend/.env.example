# Doondo backend env. Copy this file to .env for local dev. Never commit .env.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────────────────────────────
# Local Mongo: install Mongo Community + run `mongod`, or use MongoDB Atlas.
MONGODB_URI=mongodb://localhost:27017/doondo
MONGODB_DB_NAME=doondo

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
# Generate strong random strings: `openssl rand -base64 64` (run twice).
# These MUST be different. Rotate periodically; rotating invalidates all sessions.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Token lifetimes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# bcrypt cost — 10–12 is the sweet spot. Higher = slower login but stronger.
BCRYPT_ROUNDS=11

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Mobile apps don't need CORS but the
# admin web (later) will.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Verification — Phone OTP (Phase 5) ──────────────────────────────────────
# Provider selector. One of:
#   console — dev only, logs the code to the server output
#   twilio  — Twilio Verify v2 (recommended for getting started)
#   msg91   — MSG91 transactional SMS (cheapest in India; DLT registration required)
SMS_PROVIDER=console

# Twilio Verify (https://console.twilio.com → Verify → Services)
#   1. Sign up at twilio.com (free trial includes ~$15 credit).
#   2. Create a Verify Service: Verify → Services → Create. Pick a friendly name.
#   3. Copy the Service SID (starts with VA…).
#   4. Find your Account SID + Auth Token in the console homepage.
#   5. Trial accounts can only SMS verified destination numbers — verify
#      your test phone under Phone Numbers → Verified Caller IDs.
# TWILIO_ACCOUNT_SID=AC...
#
# Auth — pick ONE of these two pairs. API key is recommended (scopeable
# + rotatable without affecting the master Auth Token). When both are
# set, the API key wins.
# TWILIO_API_KEY_SID=SK...
# TWILIO_API_KEY_SECRET=...
# TWILIO_AUTH_TOKEN=...
#
# Verify service SID — Verify → Services → your service → SID.
# TWILIO_VERIFY_SERVICE_SID=VA...

# MSG91 (https://msg91.com) — only used when SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=DOONDO

# ─── Twilio WhatsApp ────────────────────────────────────────────────────────
# Reuses TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN above.
#
# Master switch. Leave false until the sandbox is configured.
TWILIO_WHATSAPP_ENABLED=false
#
# The sender — for the sandbox this is always +14155238886.
# For production, set to your approved WhatsApp Business sender.
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# Webhook validation. Leave true in prod; turn off only when you point the
# webhook at an ngrok tunnel during dev.
TWILIO_WEBHOOK_VALIDATE=true
#
# Webhook path Twilio is configured to POST to. Default is fine unless you
# remount the router.
TWILIO_WHATSAPP_WEBHOOK_PATH=/api/v1/whatsapp/webhook

# Default country code prepended when a phone has no leading "+".
PHONE_DEFAULT_COUNTRY=+91

# OTP attempts allowed before a challenge is invalidated.
OTP_MAX_ATTEMPTS=5
# OTP TTL in seconds (10 min default).
OTP_TTL_SECONDS=600
# Per-IP rate limit on /verification/phone/start (per minute).
OTP_SEND_PER_MINUTE=2

# ─── Third-party (filled in later phases) ────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# AWS_S3_BUCKET=
# AWS_REGION=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# Google Maps server key for the Distance Matrix API (real travel-time
# estimates between an employer and nearby workers). Enable "Distance Matrix
# API" on the key and restrict it to your server (IP) — do NOT reuse the
# Android Maps SDK key from apps/mobile/app.json (it's client-restricted).
# Leave unset to fall back to straight-line distance estimates.
# GOOGLE_MAPS_KEY=

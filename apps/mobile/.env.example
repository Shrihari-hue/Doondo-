# Public env vars exposed to the JS bundle. Copy this file to .env.local for
# local dev. Anything starting with EXPO_PUBLIC_ is shipped to the client —
# never put secrets here.

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_VERSION=v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Razorpay public key (set when wallet/subscriptions land in Phase 5).
# EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Maps API key (Google Maps SDK for nearby jobs map view).
# EXPO_PUBLIC_GOOGLE_MAPS_KEY=

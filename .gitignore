# Dependencies
node_modules/
.pnpm-store/
.yarn/

# Lockfiles from other package managers — this repo uses pnpm only.
# Stray npm/yarn lockfiles confuse Railway, EAS, and other CI that
# auto-detect the package manager from the lockfile.
package-lock.json
yarn.lock

# Build artifacts
dist/
build/
.expo/
.expo-shared/
.next/
out/

# Native
ios/Pods/
ios/build/
android/build/
android/app/build/
android/.gradle/
android/local.properties
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/

# EAS
.easignore

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TS
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Misc
.cache/
tmp/
temp/

# Hire Reels — mock storage provider writes uploaded videos here on a
# fresh checkout (see REEL_STORAGE_DIR; default storage/reels). Bytes are
# user-generated runtime data, never source.
apps/backend/storage/
storage/reels/
